{
  "buildCommand": "npm run build",
  "framework": "vite",
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ],
      "source": "/sitemap.xml"
    },
    {
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ],
      "source": "/robots.txt"
    }
  ],
  "outputDirectory": "dist",
